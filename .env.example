# Dermatology Bridge — Environment Configuration
# Copy to .env (or apps/api/.env) and fill in values before running.

# Database (PostgreSQL / Neon free tier in production; SQLite supported for local dev fallback)
# Example Neon URL: postgresql+psycopg://user:password@ep-example.us-east-2.aws.neon.tech/dermobridge?sslmode=require
DATABASE_URL=sqlite:///./dermobridge.db

# YouCam Skin AI API — Mock-first by default!
# Hard budget: 1,000 free units. Keep false during development and automated testing.
ALLOW_LIVE_CALLS=false
YOUCAM_API_KEY=your-youcam-api-key-here
YOUCAM_BASE_URL=https://yce-api-01.perfectcorp.com

# JWT Authentication (HS256, single signing key, no refresh tokens)
JWT_SECRET_KEY=change-me-in-production-hs256-signing-key-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Private S3-compatible Storage (Supabase Storage / Cloudinary / S3)
STORAGE_BUCKET=dermobridge-private
STORAGE_ENDPOINT_URL=https://your-project.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY_ID=your-storage-access-key
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-key
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Seed defaults (local dev / demo)
SEED_CLINICIAN_EMAIL=dr.chen@bridgederm.local
SEED_CLINICIAN_PASSWORD=clinician-demo-pass

